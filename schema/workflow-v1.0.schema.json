{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:automation-control-plane:schema:workflow:1.0",
  "title": "Automation Control Plane workflow 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "workflow_id", "version", "description", "budget_units", "default_deadline_seconds", "triggers", "steps"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "workflow_id": {"$ref": "#/$defs/identifier"},
    "version": {"type": "integer", "minimum": 1, "maximum": 2147483647},
    "description": {"type": "string", "maxLength": 4096},
    "budget_units": {"type": "integer", "minimum": 0, "maximum": 1000000000},
    "default_deadline_seconds": {"type": "integer", "minimum": 1, "maximum": 31536000},
    "triggers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/trigger"}
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {"$ref": "#/$defs/step"}
    }
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "trigger": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": {"type": {"const": "manual"}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "event"],
          "properties": {"type": {"const": "webhook"}, "event": {"$ref": "#/$defs/identifier"}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "interval_seconds"],
          "properties": {
            "type": {"const": "scheduled"},
            "interval_seconds": {"type": "integer", "minimum": 1, "maximum": 31536000}
          }
        }
      ]
    },
    "retry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_attempts", "initial_delay_seconds", "multiplier", "max_delay_seconds"],
      "properties": {
        "max_attempts": {"type": "integer", "minimum": 1, "maximum": 20},
        "initial_delay_seconds": {"type": "integer", "minimum": 0, "maximum": 31536000},
        "multiplier": {"type": "integer", "minimum": 1, "maximum": 100},
        "max_delay_seconds": {"type": "integer", "minimum": 0, "maximum": 31536000}
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "handler", "depends_on", "input", "required_capability", "approval", "estimated_cost", "timeout_seconds", "retry"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "handler": {"$ref": "#/$defs/identifier"},
        "depends_on": {"type": "array", "maxItems": 256, "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
        "input": {"type": "object", "maxProperties": 1000},
        "required_capability": {"$ref": "#/$defs/identifier"},
        "approval": {"enum": ["none", "required"]},
        "estimated_cost": {"type": "integer", "minimum": 0, "maximum": 1000000000},
        "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 86400},
        "retry": {"$ref": "#/$defs/retry"}
      }
    }
  }
}
