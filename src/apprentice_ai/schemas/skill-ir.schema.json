{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://apprentice.local/schemas/0.1.0/skill-ir.schema.json",
  "title": "SkillIR",
  "type": "object",
  "additionalProperties": false,
  "required": ["spec_version", "skill_id", "version", "intent", "inputs", "preconditions", "steps", "postconditions", "verification", "permissions", "risk", "lifecycle", "provenance"],
  "properties": {
    "spec_version": {"const": "0.1.0"}, "skill_id": {"type": "string"}, "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "intent": {"type": "string"}, "inputs": {"type": "array"}, "preconditions": {"type": "array"},
    "steps": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "action", "deterministic"]}},
    "postconditions": {"type": "array"}, "verification": {"type": "object"},
    "permissions": {"$ref": "permission-manifest.schema.json"},
    "risk": {"type": "object", "required": ["execution_supported"], "properties": {"execution_supported": {"const": false}}},
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {"enum": ["active", "stale"]},
        "reason": {"type": "string"},
        "evidence_ref": {"type": "string"},
        "invalidated_at": {"type": "string", "pattern": "Z$"}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "stale"}}, "required": ["status"]},
          "then": {"required": ["reason", "evidence_ref", "invalidated_at"]}
        }
      ]
    },
    "provenance": {"type": "object"}, "artifact_determinism": {"type": "object"}
  }
}
